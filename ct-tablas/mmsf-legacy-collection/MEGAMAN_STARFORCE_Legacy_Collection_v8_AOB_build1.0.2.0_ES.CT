                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- =====================================================================================
-- SF3 - Delete Time fijo en 1
-- Delete Time = 1 desde el inicio de la batalla y fijo hasta el final.
-- Cadena: [[sf3_base]+168]+10]+60  (4 Bytes). Requiere el [Resolver] activo.
-- Mantiene el valor FIJO mientras dure la batalla (revisa cada 30 ms).
-- Fuera de batalla la cadena no resuelve y el script no escribe nada.
-- =====================================================================================
local OLD = DELTIME_SF3
if OLD and OLD.timer then OLD.timer.destroy() end

local v = 1

DELTIME_SF3 = { objetivo = v, escrituras = 0 }
local OFFS, FIELD = { 0x168, 0x10 }, 0x60

local function campo()
  local b = getAddressSafe("sf3_base")
  if not b then return nil end
  local p = readQword(b)
  if not p or p == 0 then return nil end
  for _, o in ipairs(OFFS) do
    p = readQword(p + o)
    if not p or p == 0 or p &lt; 0x10000 then return nil end
  end
  return p + FIELD
end

local t = createTimer(nil, false)
t.Interval = 30
t.OnTimer = function()
  local ok, err = pcall(function()
    local a = campo()
    if not a then return end
    local cur = readInteger(a)
    if cur ~= nil and cur ~= DELTIME_SF3.objetivo then
      writeInteger(a, DELTIME_SF3.objetivo)
      DELTIME_SF3.escrituras = DELTIME_SF3.escrituras + 1
    end
  end)
  if not ok then print("[SF3 - Delete Time fijo en 1] " .. tostring(err)) end
end
DELTIME_SF3.timer = t
t.Enabled = true
if not getAddressSafe("sf3_base") then
  showMessage("Aviso: sf3_base no está registrado. Activa primero el [Resolver].")
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if DELTIME_SF3 and DELTIME_SF3.timer then DELTIME_SF3.timer.destroy(); DELTIME_SF3.timer = nil end
