                <CheatEntry>
                  <ID>5383</ID>
                  <Description>"Noise Gauge  [Script: fijo en batalla — pide valor 500–9999]"</Description>
                  <Options moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1" />
                  <Color>008000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- =====================================================================================
-- SF3 - Noise fijo en batalla
-- Noise Gauge Change (Current Battle). Unidades 0.1 %: 500 = 50.0 %, 9999 = 999.9 %. Pide el valor al activar.
-- Cadena: [[sf3_base]+190]+38]+2D4  (4 Bytes). Requiere el [Resolver] activo.
-- Mantiene el valor FIJO mientras dure la batalla (revisa cada 100 ms).
-- Fuera de batalla la cadena no resuelve y el script no escribe nada.
-- =====================================================================================
local OLD = NOISE_SF3
if OLD and OLD.timer then OLD.timer.destroy() end

local prev = (OLD and OLD.objetivo) or 2000
local txt = inputQuery("SF3 - Noise fijo en batalla", "Valor fijo (500 a 9999):", tostring(prev))
if txt == nil then error("Cancelado por el usuario") end
local v = tonumber(txt)
if v == nil then error("Valor no numérico: " .. tostring(txt)) end
v = math.floor(v)
if v &lt; 500 then v = 500 end
if v &gt; 9999 then v = 9999 end

NOISE_SF3 = { objetivo = v, escrituras = 0 }
local OFFS, FIELD = { 0x190, 0x38 }, 0x2D4

local function campo()
  local b = getAddressSafe("sf3_base")
  if not b then return nil end
  local p = readQword(b)
  if not p or p == 0 then return nil end
  for _, o in ipairs(OFFS) do
    p = readQword(p + o)
    if not p or p == 0 or p &lt; 0x10000 then return nil end
  end
  return p + FIELD
end

local t = createTimer(nil, false)
t.Interval = 100
t.OnTimer = function()
  local ok, err = pcall(function()
    local a = campo()
    if not a then return end
    local cur = readInteger(a)
    if cur ~= nil and cur ~= NOISE_SF3.objetivo then
      writeInteger(a, NOISE_SF3.objetivo)
      NOISE_SF3.escrituras = NOISE_SF3.escrituras + 1
    end
  end)
  if not ok then print("[SF3 - Noise fijo en batalla] " .. tostring(err)) end
end
NOISE_SF3.timer = t
t.Enabled = true
if not getAddressSafe("sf3_base") then
  showMessage("Aviso: sf3_base no está registrado. Activa primero el [Resolver].")
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if NOISE_SF3 and NOISE_SF3.timer then NOISE_SF3.timer.destroy(); NOISE_SF3.timer = nil end
{$asm}
