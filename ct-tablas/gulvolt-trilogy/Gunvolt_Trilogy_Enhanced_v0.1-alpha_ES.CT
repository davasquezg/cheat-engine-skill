    <CheatEntry>
      <ID>380</ID>
      <Description>"▶ Azure Striker Gunvolt 3 (game3.exe) — activar para adjuntar"</Description>
      <Color>0080FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Adjunta Cheat Engine a game3.exe (patrón de wepon1984). Activar con el juego abierto. }
[ENABLE]
{$lua}
if syntaxcheck then return end
if getCEVersion() &lt; 7.4 then showMessage("Se recomienda Cheat Engine 7.4 o superior.") end
if (process or ""):lower() ~= "game3.exe" then openProcess("game3.exe") end
if (process or ""):lower() ~= "game3.exe" then
  error("game3.exe no está abierto: entra a ese juego desde el menú de la colección.")
end
{$asm}
[DISABLE]
</AssemblerScript>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
      <CheatEntries>
        <CheatEntry>
          <ID>381</ID>
          <Description>"##Grupo de wepon1984 portado sin cambios (nombres originales). Sin verificar en nuestra build de game3.exe."</Description>
          <Color>0080FF</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>382</ID>
          <Description>"Health"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
          <Color>408000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(health,game3.exe,F3 0F 11 41 08 83 49 18 01 C3 0F)
alloc(newmem,$100,health)
alloc(player,4)
alloc(enemy,4)
label(code)
label(return)
registersymbol(health enemy player)

newmem:
cmp [rcx+20],#1
jne @f
cmp [player],0
je code
movss xmm0,[rcx+0C]
movss [rcx+08],xmm0
jmp return

@@:

  cmp [enemy],0
  je code
  mov [rcx+08],00
  jmp return

code:
  movss [rcx+08],xmm0
  jmp return

health:
  jmp newmem
return:

player:
dd 0

enemy:
dd 0


[DISABLE]

health:
  db F3 0F 11 41 08

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
