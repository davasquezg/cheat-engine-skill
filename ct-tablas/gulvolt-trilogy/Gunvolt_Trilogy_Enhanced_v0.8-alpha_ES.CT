          <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
          <Color>408000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(health,game3.exe,F3 0F 11 41 08 83 49 18 01 C3 0F)
alloc(newmem,$100,health)
alloc(player,4)
alloc(enemy,4)
label(code)
label(return)
registersymbol(health enemy player)

newmem:
cmp [rcx+20],#1
jne @f
cmp [player],0
je code
movss xmm0,[rcx+0C]
movss [rcx+08],xmm0
jmp return

@@:

  cmp [enemy],0
  je code
  mov [rcx+08],00
  jmp return

code:
  movss [rcx+08],xmm0
  jmp return

health:
  jmp newmem
return:

player:
dd 0

enemy:
dd 0


[DISABLE]

health:
  db F3 0F 11 41 08

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
