{$lua}
if syntaxcheck then return end
-- =====================================================================================
-- invencible_gv1.lua — Invencibilidad de GV1 como interruptor (activar = Sí, desactivar = No).
-- Mantiene el temporizador de invencibilidad del jugador ([gv1_player]+0x518) en 11520
-- (valor que el juego pone tras un golpe; confirmado 2026-11-01). Requiere la sonda 1.
-- Licencia: PolyForm Noncommercial 1.0.0.
-- =====================================================================================
if INV_GV1 and INV_GV1.timer then INV_GV1.timer.destroy() end
if not getAddressSafe("gv1_player") then
  local r = getAddressList().getMemoryRecordByDescription("Captura jugador (base de los trucos; se activa sola)")
  if r and not r.Active then r.Active = true end
end
if not getAddressSafe("gv1_player") then
  error("No se pudo activar 'Captura jugador'. Entra a un nivel y vuelve a intentar.")
end
INV_GV1 = {}
local t = createTimer(nil, false)
t.Interval = 50
t.OnTimer = function()
  pcall(function()
    local pp = getAddressSafe("gv1_player")
    local P = pp and readQword(pp)
    if P and P &gt; 0x10000 then
      local a = P + 0x518
      local v = readInteger(a)
      if v ~= nil and v &lt; 11520 then writeInteger(a, 11520) end
    end
  end)
end
INV_GV1.timer = t
t.Enabled = true

{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if INV_GV1 and INV_GV1.timer then INV_GV1.timer.destroy(); INV_GV1.timer = nil end

{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>16</ID>
              <Description>"Prestigio ×N / mantener (localiza el Prestigio solo; elegir ×N abajo)"</Description>
              <Color>008000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
KUDOS_SILENCIO = true
local okK, errK = pcall(function()
-- =====================================================================================
-- kudos_gv1.lua — Localiza el Prestigio (Kudos) de GV1 en el heap por FIRMA DE MEMORIA,
-- sin depurador ni punteros estáticos (no hay de 1-2 niveles). Hallado el 2026-11-01:
--   K+0x0 = Prestigio en pantalla      K+0x4 = Prestigio interno ×256 (punto fijo 24.8)
--   K+0x34, K+0x3C = punteros a código de game1.exe (+234130, +4C470) — ESTABLES entre corridas
--   (K+0xC también apunta a código pero CAMBIA según el estado: +B2500 / +B6640; no se usa)
-- Registra:  gv1_kudos     = K+0x4 (interno; es el que hay que modificar)
--            gv1_kudos_vis = K+0x0 (pantalla; el juego lo recalcula desde el interno)
-- Un temporizador re-localiza la estructura si cambia (p. ej. al cambiar de nivel).
-- Licencia: PolyForm Noncommercial 1.0.0.
-- =====================================================================================
if KUDOS_GV1 and KUDOS_GV1.timer then KUDOS_GV1.timer.destroy() end
local base = getAddressSafe("game1.exe")
if not base then error("Adjunta Cheat Engine a game1.exe") end
local F2, F3 = base + 0x234130, base + 0x4C470

local function valido(K)
  return K and readQword(K + 0x34) == F2 and readQword(K + 0x3C) == F3
end

-- La firma (+34/+3C) la comparten ~200 objetos del mismo tipo (diagnóstico 2026-11-01: 214).
-- Se elige el del Prestigio así: 1) campo K-0x14 = 1662 (constante en las 4 corridas observadas),
-- 2) interno = pantalla × 256, 3) pantalla &gt; 0, 4) si aún hay dudas, el que CAMBIE (ver temporizador).
local ID_KUDOS = 1662

local function localizar()
  local ms = createMemScan()
  ms.firstScan(soExactValue, vtQword, rtRounded, string.format("%X", F2), "", 0x10000, 0x7FFFFFFFFFFF,
               "+W", fsmAligned, "4", true, false, false, false)
  ms.waitTillDone()
  local fl = createFoundList(ms); fl.initialize()
  local cands = {}
  for i = 0, math.min(fl.Count, 5000) - 1 do
    local K = tonumber(fl.Address[i], 16) - 0x34
    if valido(K) then
      local vis, raw = readInteger(K), readInteger(K + 4)
      if raw ~= nil and vis ~= nil and raw // 256 == vis then
        cands[#cands + 1] = { K = K, vis = vis, id = readInteger(K - 0x14) }
      end
    end
  end
  fl.deinitialize(); fl.destroy(); ms.destroy()
  local function primero(f) for _, c in ipairs(cands) do if f(c) then return c.K end end end
  local K = primero(function(c) return c.id == ID_KUDOS and c.vis &gt; 0 end)
         or primero(function(c) return c.id == ID_KUDOS end)
         or primero(function(c) return c.vis &gt; 0 end)
  return K, #cands, cands
end

local function registrar(K)
  registerSymbol("gv1_kudos", K + 4, true)
  registerSymbol("gv1_kudos_vis", K, true)
  KUDOS_GV1.K = K
end

KUDOS_GV1 = { K = nil }
local K, n = localizar()
if K then registrar(K) end

local t = createTimer(nil, false)
t.Interval = 3000
t.OnTimer = function()
  pcall(function()
    local K = KUDOS_GV1.K
    if not valido(K) or (readInteger(K - 0x14) ~= ID_KUDOS and (readInteger(K) or 0) == 0) then
      local K2 = localizar()
      if K2 then registrar(K2) end
    end
  end)
end
KUDOS_GV1.timer = t
t.Enabled = true
if not KUDOS_SILENCIO then
  if K then
    showMessage(string.format("Prestigio localizado en %X (candidatos con la firma: %d).\n" ..
      "gv1_kudos = interno ×256 · gv1_kudos_vis = pantalla.\nSe re-localiza solo si cambia de nivel.", K, n))
  else
    showMessage("Prestigio aún no localizado (¿fuera de un nivel?). Se buscará automáticamente cada 3 s.")
  end
end

end)
KUDOS_SILENCIO = nil
if not okK then print('[Prestigio] ' .. tostring(errK)) end
-- =====================================================================================
-- prestigio_mult_gv1.lua — Multiplica las GANANCIAS de Prestigio (gv1_kudos, interno ×256) y,
-- opcionalmente, impide que BAJE al recibir golpes. Sin inyectar código: un temporizador compara
-- el valor con el anterior y suma (ganancia × (k − 1)).
-- El factor y el «mantener» se eligen en las listas desplegables de la tabla, que leen/escriben:
--   gv1_kudos_mult = factor 1, 2, 4 … 1024 (por defecto 2)   gv1_kudos_keep = 0 No / 1 Sí (por defecto 0)
-- (4 bytes cada uno en memoria reservada dentro del juego; se pueden cambiar en vivo).
-- Requiere gv1_kudos (kudos_gv1.lua). Tope: 9999 en pantalla (= 9999 × 256 interno).
-- Ojo: el juego baja el Prestigio a 0 al canjearlo al final del nivel; con «mantener» se quedará fijo.
-- Licencia: PolyForm Noncommercial 1.0.0.
-- =====================================================================================
if MULTI_KUDOS and MULTI_KUDOS.timer then MULTI_KUDOS.timer.destroy() end
local TOPE = 9999 * 256

-- Variables de 4 bytes en el juego (se reutilizan si ya existen: lo elegido sobrevive a desactivar)
local aMult = getAddressSafe("gv1_kudos_mult")
if not aMult then
  aMult = allocateMemory(16)
  registerSymbol("gv1_kudos_mult", aMult, true)
  writeInteger(aMult, 2)
end
local aKeep = getAddressSafe("gv1_kudos_keep")
if not aKeep then
  aKeep = allocateMemory(16)
  registerSymbol("gv1_kudos_keep", aKeep, true)
  writeInteger(aKeep, 0)
end

local function factor()
  local k = readInteger(aMult) or 1
  if k &lt; 1 then k = 1 end
  if k &gt; 1024 then k = 1024 end
  return k
end

MULTI_KUDOS = { a = nil, last = nil }
local tm = createTimer(nil, false)
tm.Interval = 50
tm.OnTimer = function()
  pcall(function()
    local a = getAddressSafe("gv1_kudos")
    if not a then MULTI_KUDOS.a = nil; MULTI_KUDOS.last = nil; return end
    if a ~= MULTI_KUDOS.a then MULTI_KUDOS.a = a; MULTI_KUDOS.last = readInteger(a); return end
    local v, last = readInteger(a), MULTI_KUDOS.last
    if v and last then
      local k = factor()
      if v &gt; last and k &gt; 1 then
        v = math.min(last + (v - last) * k, TOPE)
        writeInteger(a, v)
      elseif v &lt; last and readInteger(aKeep) == 1 then
        writeInteger(a, last); v = last
      end
    end
    MULTI_KUDOS.last = v
  end)
end
MULTI_KUDOS.timer = tm
tm.Enabled = true

{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if MULTI_KUDOS and MULTI_KUDOS.timer then MULTI_KUDOS.timer.destroy(); MULTI_KUDOS.timer = nil end

if KUDOS_GV1 and KUDOS_GV1.timer then KUDOS_GV1.timer.destroy(); KUDOS_GV1.timer = nil end
unregisterSymbol("gv1_kudos"); unregisterSymbol("gv1_kudos_vis")

{$asm}
</AssemblerScript>
