          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>89</ID>
              <Description>"Contador de daño (7 sitios)"</Description>
              <Color>008000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Sonda 2 — Contador de daño: 7 sitios que restan HP. 'jugador' = víctima es [gv1_hp].
  Activa sola la Captura jugador si hace falta. Aborta si los bytes no son los originales (build 2026-10-07) ni un jmp de una activación anterior. }
[ENABLE]
{$lua}
if syntaxcheck then return end
if not getAddressSafe("gv1_hp") then
  local r = getAddressList().getMemoryRecordByDescription("Captura jugador (base de los trucos; se activa sola)")
  if r and not r.Active then r.Active = true end
end
if not getAddressSafe("gv1_hp") then error("No se pudo activar 'Captura jugador'. Entra a un nivel.") end
local base = getAddress('game1.exe')
local SITES = {
  {0x90D41, '4C 8B 83 D8 03 00 00'},
  {0x91494, '4C 8B 81 D8 03 00 00'},
  {0x915FA, '4C 8B 81 D8 03 00 00'},
  {0x91899, '4C 8B 81 D8 03 00 00'},
  {0x91A8E, '4C 8B 89 D8 03 00 00'},
  {0x1A2729, '4C 8B 80 D8 03 00 00'},
  {0x1AAB62, '4C 8B 87 D8 03 00 00'},
}
for _, st in ipairs(SITES) do
  local t = readBytes(base + st[1], 7, true) or {}
  local h = {}
  for i = 1, #t do h[i] = string.format('%02X', t[i]) end
  local hs = table.concat(h, ' ')
  if hs ~= st[2] and t[1] ~= 0xE9 then
    error(string.format('Bytes inesperados en game1.exe+%X: %s (¿otra build?)', st[1], hs))
  end
end
{$asm}
alloc(sonda_mem,$1000,game1.exe)
label(cnt_tab)
registersymbol(cnt_tab)
label(hook_0)
label(hook_1)
label(hook_2)
label(hook_3)
label(hook_4)
label(hook_5)
label(hook_6)

sonda_mem:
hook_0:
  mov r8,[rbx+3D8]
  pushfq
  push rax
  lock inc dword ptr [cnt_tab+4]
  mov rax,[gv1_hp]
  cmp r8,rax
  jne @f
  lock inc dword ptr [cnt_tab+0]
@@:
  pop rax
  popfq
  jmp game1.exe+90D48

hook_1:
  mov r8,[rcx+3D8]
  pushfq
  push rax
  lock inc dword ptr [cnt_tab+C]
  mov rax,[gv1_hp]
  cmp r8,rax
  jne @f
  lock inc dword ptr [cnt_tab+8]
@@:
  pop rax
  popfq
  jmp game1.exe+9149B

hook_2:
  mov r8,[rcx+3D8]
  pushfq
  push rax
  lock inc dword ptr [cnt_tab+14]
  mov rax,[gv1_hp]
  cmp r8,rax
  jne @f
  lock inc dword ptr [cnt_tab+10]
@@:
  pop rax
  popfq
  jmp game1.exe+91601

hook_3:
  mov r8,[rcx+3D8]
  pushfq
  push rax
  lock inc dword ptr [cnt_tab+1C]
  mov rax,[gv1_hp]
  cmp r8,rax
  jne @f
  lock inc dword ptr [cnt_tab+18]
@@:
  pop rax
  popfq
  jmp game1.exe+918A0

hook_4:
  mov r9,[rcx+3D8]
  pushfq
